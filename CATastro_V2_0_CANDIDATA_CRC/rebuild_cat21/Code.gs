/** CATastro V2.0 — backend de escritura confirmada e idempotente. */
const CONFIG={SPREADSHEET_ID:'1BxYD--lvjd7TqRk9NqULS7m4jOVtwCdPKGQo0xPoAuo',HOJA:'SABANA_RECOLECCION',TOKEN:'CAT-hUpk8PehG9j2j4xZMYsPZ-Fr1XMgsY4jufSUwnp4',VERSION:'2.0.0'};
const HEADERS=['ID_REGISTRO','ID_RECORRIDO','ID_ASIGNACION','NIM','MGN','DEPARTAMENTO','MUNICIPIO','ZONA','SEGMENTO','SUPERVISOR','ENCUESTADOR','UNIVERSO','VIVIENDA','ALEATORIO','ORDEN_SORTEO','SELECCIONADA','ORDEN_SELECCION','METODO_SELECCION','RESULTADO_VISITA','LATITUD','LONGITUD','ALTITUD_M','PRECISION_M','FECHA_GPS','IDENTIFICADOR_VIVIENDA','URL_KOBO','ESTADO_RECORRIDO','ESTADO_REGISTRO','FECHA_GENERACION','FECHA_ACTUALIZACION','ESTADO_SINCRONIZACION','REQUEST_ID'];
function doGet(e){const p=e&&e.parameter||{};if(p.action==='check')return checkRequest_(p);const ss=SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);const sh=ss.getSheetByName(CONFIG.HOJA);return json_({ok:true,servicio:'CATastro – Recolección',version:CONFIG.VERSION,hoja:CONFIG.HOJA,hojaEncontrada:!!sh,estado:sh?'LISTO':'FALTA_HOJA'});}
function doPost(e){let requestId='';try{const raw=e&&e.postData&&e.postData.contents||'';const payload=raw?JSON.parse(raw):{};if(payload.token!==CONFIG.TOKEN)throw new Error('Token no válido.');requestId=String(payload.requestId||'');if(!/^[A-Za-z0-9_-]{8,100}$/.test(requestId))throw new Error('Falta requestId válido.');const registros=Array.isArray(payload.registros)?payload.registros:[];if(!registros.length)throw new Error('No se recibieron registros.');const lock=LockService.getScriptLock();lock.waitLock(25000);let totals={filas:0,insertadas:0,actualizadas:0};try{const sh=getSheet_();ensureHeaders_(sh);registros.forEach(r=>{const x=upsertRecord_(sh,r,requestId);totals.filas+=x.filas;totals.insertadas+=x.insertadas;totals.actualizadas+=x.actualizadas});SpreadsheetApp.flush()}finally{lock.releaseLock()}const result={ok:true,requestId,recorridos:registros.length,...totals,version:CONFIG.VERSION,hoja:CONFIG.HOJA,completedAt:new Date().toISOString()};PropertiesService.getScriptProperties().setProperty('SYNC_'+requestId,JSON.stringify(result));return json_(result)}catch(err){const result={ok:false,requestId,error:String(err&&err.message||err),version:CONFIG.VERSION};if(requestId)PropertiesService.getScriptProperties().setProperty('SYNC_'+requestId,JSON.stringify(result));console.error(err);return json_(result)}}
function checkRequest_(p){const cb=String(p.callback||'');if(!/^[A-Za-z_$][0-9A-Za-z_$]{0,100}$/.test(cb))return ContentService.createTextOutput('/* invalid callback */').setMimeType(ContentService.MimeType.JAVASCRIPT);if(p.token!==CONFIG.TOKEN)return jsonp_(cb,{ok:false,error:'Token no válido.'});const id=String(p.requestId||'');if(!/^[A-Za-z0-9_-]{8,100}$/.test(id))return jsonp_(cb,{ok:false,error:'requestId no válido.'});const raw=PropertiesService.getScriptProperties().getProperty('SYNC_'+id);return jsonp_(cb,raw?JSON.parse(raw):{ok:false,pending:true,requestId:id})}
function getSheet_(){const ss=SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);let sh=ss.getSheetByName(CONFIG.HOJA);if(!sh)sh=ss.insertSheet(CONFIG.HOJA);return sh}
function ensureHeaders_(sh){const lastCol=Math.max(sh.getLastColumn(),0);if(sh.getLastRow()===0||lastCol===0){sh.getRange(1,1,1,HEADERS.length).setValues([HEADERS]);sh.setFrozenRows(1);sh.getRange(1,1,1,HEADERS.length).setFontWeight('bold').setFontColor('#fff').setBackground('#123b5d');}else{const got=sh.getRange(1,1,1,lastCol).getDisplayValues()[0];const common=Math.min(got.length,HEADERS.length);for(let i=0;i<common;i++){if(got[i]!==HEADERS[i])throw new Error('Encabezado incompatible en columna '+(i+1)+': se esperaba '+HEADERS[i]+' y existe '+got[i]+'. No se modificó la hoja.');}if(lastCol>HEADERS.length)throw new Error('La sábana tiene columnas adicionales no reconocidas. No se modificó la hoja.');if(lastCol<HEADERS.length){sh.getRange(1,lastCol+1,1,HEADERS.length-lastCol).setValues([HEADERS.slice(lastCol)]);sh.getRange(1,lastCol+1,1,HEADERS.length-lastCol).setFontWeight('bold').setFontColor('#fff').setBackground('#123b5d');}}sh.setFrozenRows(1);sh.getRange(2,1,Math.max(sh.getMaxRows()-1,1),13).setNumberFormat('@');}
function upsertRecord_(sh,r,requestId){if(!r||!r.idRecorrido)throw new Error('Registro sin idRecorrido.');if(!Array.isArray(r.seleccion)||!r.seleccion.length)throw new Error('El recorrido '+r.idRecorrido+' no tiene viviendas seleccionadas.');if(!Array.isArray(r.universoAuditoria)||!r.universoAuditoria.length)throw new Error('El recorrido '+r.idRecorrido+' no incluye universoAuditoria.');const selected=new Map(r.seleccion.map(v=>[String(v.vivienda),v]));const rows=r.universoAuditoria.map((u,i)=>{const v=selected.get(String(u.vivienda))||null;return [String(r.idRecorrido)+'::'+String(u.vivienda),String(r.idRecorrido),String(r.idAsignacion||''),String(r.nim||''),String(r.mgn||''),String(r.departamento||''),String(r.municipio||''),String(r.zona||''),String(r.idSegmento||''),String(r.supervisor||''),String(r.encuestador||''),Number(r.conteo||r.universoAuditoria.length),String(u.vivienda),u.aleatorio==null?'':Number(u.aleatorio),i+1,v?'SI':'NO',v?Number(v.orden):'',String(r.metodo||''),v?String(v.resultado||''):'',v&&v.gpsLatitud!=null?Number(v.gpsLatitud):'',v&&v.gpsLongitud!=null?Number(v.gpsLongitud):'',v&&v.gpsAltitud!=null?Number(v.gpsAltitud):'',v&&v.gpsPrecision!=null?Number(v.gpsPrecision):'',v&&v.gpsFecha?new Date(v.gpsFecha):'',v?String(v.identificador||''):[r.nim,r.mgn,u.vivienda].join('|'),v?String(v.koboUrl||''):'',String(r.estado||'EN_PROCESO'),String(r.estado_registro||'ACTIVO'),date_(r.fechaGeneracion),date_(r.actualizado),String(r.estado_sincronizacion||'PENDIENTE'),requestId]});const last=sh.getLastRow();const index=new Map();if(last>1){const ids=sh.getRange(2,1,last-1,1).getDisplayValues();ids.forEach((x,i)=>{if(x[0])index.set(String(x[0]),i+2)})}let inserted=0,updated=0;rows.forEach(row=>{const found=index.get(row[0]);if(found){sh.getRange(found,1,1,HEADERS.length).setValues([row]);updated++}else{const target=sh.getLastRow()+1;sh.getRange(target,1,1,HEADERS.length).setValues([row]);index.set(row[0],target);inserted++}});return {filas:rows.length,insertadas:inserted,actualizadas:updated}}
function date_(v){if(!v)return '';const d=new Date(v);return isNaN(d.getTime())?'':d}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
function jsonp_(cb,o){return ContentService.createTextOutput(cb+'('+JSON.stringify(o)+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}
function crearSabanaRecoleccion(){const ss=SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);let sh=ss.getSheetByName(CONFIG.HOJA);if(!sh)sh=ss.insertSheet(CONFIG.HOJA);ensureHeaders_(sh);return 'SABANA_RECOLECCION lista para CATastro V2.0.'}
